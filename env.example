# ══════════════════════════════════════════════════════════════
#  CAMI'S EVENTOS — Configuração do servidor
#  Copie este ficheiro para ".env" e preencha os valores.
# ══════════════════════════════════════════════════════════════

# Base de dados MySQL (obrigatório)
# Formato: mysql://UTILIZADOR:SENHA@SERVIDOR:3306/camis
# Com docker-compose, use exactamente o valor abaixo (senha = a que escolher no compose):
DATABASE_URL=mysql://camis:TROQUE-ESTA-SENHA@db:3306/camis

# Chaves internas da aplicação (obrigatório existir, pode ser qualquer texto longo)
# Gere uma senha forte aleatória, ex.: openssl rand -hex 32
APP_ID=camis-eventos
APP_SECRET=TROQUE-POR-UMA-CHAVE-LONGA-E-ALEATORIA

# Porta do sistema (por defeito 3000)
PORT=3000
